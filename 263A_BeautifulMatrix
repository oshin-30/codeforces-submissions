import java.util.*;
public class Main{
    public static void main(String[] args){
        int result = 0;
        Scanner sc = new Scanner(System.in);
        for(int i = 0;i < 5;i++){
            for(int j = 0;j < 5;j++){
                int a = sc.nextInt();
                if(a == 1){
                    result = Math.abs(2 - i) + Math.abs(2 - j);
                }
            }
        }
        System.out.println(result);
    }
}
